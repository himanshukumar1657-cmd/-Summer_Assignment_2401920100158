
// Move Zeroes

class Solution {
    public void moveZeroes(int[] nums) {
        int point1 = 0;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                nums[point1] = nums[i];
                point1++;
            }
        }
        while (point1 < nums.length) {
            nums[point1] = 0;
            point1++;
        }

    }
}

// Squares of a Sorted Array

class Solution {
    public int[] sortedSquares(int[] nums) {
        int n=nums.length;
        int result[]=new int[n];
        for(int i=0;i<n;i++){
            nums[i]=nums[i]*nums[i];
        }
        int head=0;
        int tail=n-1;
        for(int j=n-1;j>=0;j--){
            if(nums[head]>nums[tail]){
             result[j]=nums[head];
             head++;
            }
            else{
             result[j]=nums[tail];
              tail--;
            }
        }       
   
return result;
 }
}


//  Container With Most Water 

import java.util.*;
class Solution {
    public int maxArea(int[] height) {
        int right=0;
        int left=height.length-1;
        int maxwater=0;

        while(right<left){
            int width=left-right;
            int current=Math.min(height[left],height[right]);
            int area= current*width;
            
            if(area>maxwater){
              maxwater=area;

            }
            if(height[right]>height[left]){
                left--;
            }
            else{
                right++;
            }
            
            

        }
        return maxwater;
        
    }
}
